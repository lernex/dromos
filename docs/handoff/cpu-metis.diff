new file mode 100644
index 0000000..24d55c9
--- /dev/null
+++ b/engine/model/glue_cpu.cpp
@@ -0,0 +1,48 @@
+// The model's glue kernels (glue.h) for backends whose device memory is host memory (the CPU): the
+// same four operations as glue.cu, as loops. The streams are synchronous there, so `stream` is unused.
+#include <cstring>
+
+#include "model/glue.h"
+
+namespace lx::glue {
+namespace {
+
+uint16_t to_bf16(float f) {
+  uint32_t u;
+  std::memcpy(&u, &f, 4);
+  if ((u & 0x7fffffffu) > 0x7f800000u) return static_cast<uint16_t>((u >> 16) | 0x40u);
+  u += 0x7fffu + ((u >> 16) & 1u);
+  return static_cast<uint16_t>(u >> 16);
+}
+
+}  // namespace
+
+int axpby(float* y, const float* x, float a, float b, int64_t n, void*) {
+  for (int64_t i = 0; i < n; ++i) y[i] = a * y[i] + b * x[i];
+  return 0;
+}
+
+int sub(const float* a, const float* b, float* out, int64_t n, void*) {
+  for (int64_t i = 0; i < n; ++i) out[i] = a[i] - b[i];
+  return 0;
+}
+
+int meta_scalars(const float* entropy, const float* confidence, const float* continuation, float mean_k,
+                 float inv_log_experts, void* meta, int ld, int col, int T, void*) {
+  for (int t = 0; t < T; ++t) {
+    uint16_t* row = static_cast<uint16_t*>(meta) + static_cast<int64_t>(t) * ld + col;
+    row[0] = to_bf16(mean_k);
+    row[1] = to_bf16(entropy[t] * inv_log_experts);
+    row[2] = to_bf16(confidence[t]);
+    row[3] = to_bf16(continuation[t]);
+  }
+  return 0;
+}
+
+int gather_last(const float* src, const int32_t* cu, float* out, int n_seq, int D, void*) {
+  for (int i = 0; i < n_seq; ++i)
+    std::memcpy(out + static_cast<int64_t>(i) * D, src + static_cast<int64_t>(cu[i + 1] - 1) * D, sizeof(float) * D);
+  return 0;
+}
+
+}  // namespace lx::glue
