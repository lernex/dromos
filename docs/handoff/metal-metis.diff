--- a/engine/core/mapped_weights.h
+++ b/engine/core/mapped_weights.h
@@ -0,0 +1,62 @@
+// A BF16 checkpoint loaded through the backend runtime (kernels.h, "Runtime"), for the model's
+// WeightLookup and ProjectionLookup. Where the backend shares memory with the host (Metal, the CPU),
+// tensors are used where the file is mapped: lx_rt_map_host makes the mapping readable by kernels,
+// so a BF16 model loads without a copy. Elsewhere they are copied (lx_rt_alloc + lx_rt_copy).
+//
+// Projections are converted to the recipe's format at load with lx_quantize_weight, one tensor (one
+// expert for NVFP4 stacks) at a time, reading the mapped file in place: the peak is the final
+// footprint, never the BF16 model plus the converted one.
+#pragma once
+
+#include <filesystem>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "core/safetensors.h"
+#include "cuda/kernels.h"
+#include "model/metis.h"
+
+namespace lx {
+
+struct WeightRecipe {
+  lx_wtype projections = LX_W_BF16;  // every projection the model lets be quantized
+  lx_wtype experts = LX_W_BF16;      // the routed expert stacks
+  // Name fragments that stay BF16 whatever the format: the Mamba-2 out_proj by default, the one part
+  // of Metis that 8-bit visibly hurts (as for the GGUF, FP8 and MLX releases).
+  std::vector<std::string> keep = {"out_proj"};
+
+  // "bf16", "int8" (every quantizable projection INT8), "fp8", "nvfp4" (routed experts NVFP4, the
+  // rest INT8: the layout of the MLX 4-bit release, so the two compare format for format).
+  static WeightRecipe named(const std::string& name);
+  std::string describe() const;
+};
+
+class MappedWeights {
+ public:
+  MappedWeights(const std::filesystem::path& dir, const WeightRecipe& recipe);
+  ~MappedWeights();
+  MappedWeights(const MappedWeights&) = delete;
+  MappedWeights& operator=(const MappedWeights&) = delete;
+
+  WeightLookup plain();
+  ProjectionLookup projections();
+
+  size_t device_bytes() const noexcept { return device_bytes_; }  // allocated for copies and conversions
+  size_t mapped_bytes() const noexcept { return mapped_bytes_; }  // used in place from the file
+
+ private:
+  const void* resident(const TensorInfo& t);  // a device view of t: mapped in place, or copied
+  void* allocate(size_t bytes);
+  lx_weight convert(const TensorInfo& t, lx_wtype type);
+
+  SafetensorsSet set_;
+  WeightRecipe recipe_;
+  std::vector<void*> allocations_;
+  std::vector<void*> mapped_;  // host ranges registered with lx_rt_map_host for the whole run
+  std::map<std::string, const void*> views_;
+  bool map_all_ = false;  // the whole file is mapped (a BF16 load on a shared-memory backend)
+  size_t device_bytes_ = 0, mapped_bytes_ = 0;
+};
+
+}  // namespace lx
--- a/engine/core/mapped_weights.cpp
+++ b/engine/core/mapped_weights.cpp
@@ -0,0 +1,207 @@
+#include "core/mapped_weights.h"
+
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+namespace lx {
+namespace {
+
+void check(int status, const std::string& what) {
+  if (status != 0) throw std::runtime_error(what + " failed with status " + std::to_string(status));
+}
+
+uintptr_t page_size() { return static_cast<uintptr_t>(::getpagesize()); }
+
+std::string shape_text(const std::vector<int64_t>& shape) {
+  std::string s = "[";
+  for (size_t i = 0; i < shape.size(); ++i) s += (i ? ", " : "") + std::to_string(shape[i]);
+  return s + "]";
+}
+
+size_t data_bytes(lx_wtype t, int64_t rows, int64_t K) {
+  switch (t) {
+    case LX_W_BF16: return static_cast<size_t>(rows * K * 2);
+    case LX_W_NVFP4: return static_cast<size_t>(rows * (K / 2));
+    default: return static_cast<size_t>(rows * K);
+  }
+}
+size_t scale_bytes(lx_wtype t, int64_t rows, int64_t K) {
+  switch (t) {
+    case LX_W_INT8:
+    case LX_W_FP8: return static_cast<size_t>(rows * 4);
+    case LX_W_NVFP4: return static_cast<size_t>(rows * (K / 16));
+    default: return 0;
+  }
+}
+
+const char* format_name(lx_wtype t) {
+  switch (t) {
+    case LX_W_BF16: return "BF16";
+    case LX_W_INT8: return "INT8";
+    case LX_W_FP8: return "FP8";
+    case LX_W_NVFP4: return "NVFP4";
+  }
+  return "?";
+}
+
+}  // namespace
+
+WeightRecipe WeightRecipe::named(const std::string& name) {
+  WeightRecipe r;
+  if (name == "bf16") return r;
+  if (name == "int8") r.projections = r.experts = LX_W_INT8;
+  else if (name == "fp8") r.projections = r.experts = LX_W_FP8;
+  else if (name == "nvfp4") {
+    r.projections = LX_W_INT8;
+    r.experts = LX_W_NVFP4;
+  } else {
+    throw std::runtime_error("unknown weight format \"" + name + "\" (bf16, int8, fp8 or nvfp4)");
+  }
+  return r;
+}
+
+std::string WeightRecipe::describe() const {
+  std::string s = std::string("projections ") + format_name(projections) + ", experts " + format_name(experts);
+  if (projections != LX_W_BF16 || experts != LX_W_BF16) {
+    s += ", BF16:";
+    for (const auto& k : keep) s += " " + k;
+  }
+  return s;
+}
+
+MappedWeights::MappedWeights(const std::filesystem::path& dir, const WeightRecipe& recipe)
+    : set_(SafetensorsSet::open(dir)), recipe_(recipe) {
+  // A BF16 load maps the whole checkpoint once when the backend can use host memory in place.
+  if (recipe_.projections == LX_W_BF16 && recipe_.experts == LX_W_BF16 && set_.file_count() == 1) {
+    uintptr_t lo = UINTPTR_MAX, hi = 0;
+    for (const auto& [name, t] : set_.tensors()) {
+      if (!t.bytes) continue;
+      lo = std::min(lo, reinterpret_cast<uintptr_t>(t.data));
+      hi = std::max(hi, reinterpret_cast<uintptr_t>(t.data) + t.bytes);
+    }
+    void* dev = nullptr;
+    if (hi > lo && lx_rt_map_host(reinterpret_cast<void*>(lo), static_cast<int64_t>(hi - lo), &dev) == 0) {
+      if (dev != reinterpret_cast<void*>(lo)) throw std::runtime_error("lx_rt_map_host moved the mapping");
+      mapped_.push_back(reinterpret_cast<void*>(lo));
+      map_all_ = true;
+      mapped_bytes_ = hi - lo;
+    }
+  }
+}
+
+MappedWeights::~MappedWeights() {
+  lx_rt_stream_sync(nullptr);
+  for (void* p : mapped_) lx_rt_unmap_host(p);
+  for (void* p : allocations_) lx_rt_free(p);
+}
+
+void* MappedWeights::allocate(size_t bytes) {
+  void* p = nullptr;
+  check(lx_rt_alloc(&p, static_cast<int64_t>(std::max<size_t>(bytes, 16))), "lx_rt_alloc");
+  allocations_.push_back(p);
+  device_bytes_ += bytes;
+  return p;
+}
+
+// A device view of a tensor for the whole run. In place when the file is mapped and the data starts
+// on a 16-byte boundary (the vector loads of the products need it); copied otherwise.
+const void* MappedWeights::resident(const TensorInfo& t) {
+  const auto it = views_.find(t.name);
+  if (it != views_.end()) return it->second;
+  const void* view = nullptr;
+  if (map_all_ && (reinterpret_cast<uintptr_t>(t.data) & 15) == 0) {
+    view = t.data;
+  } else {
+    void* p = allocate(t.bytes);
+    check(lx_rt_copy(p, t.data, static_cast<int64_t>(t.bytes), LX_COPY_H2D, nullptr), "uploading " + t.name);
+    view = p;
+  }
+  views_.emplace(t.name, view);
+  return view;
+}
+
+WeightLookup MappedWeights::plain() {
+  return [this](const std::string& name) {
+    WeightView view;
+    const TensorInfo* t = set_.find(name);
+    if (!t) return view;
+    view.dtype = t->dtype == DType::F32 ? LX_F32 : t->dtype == DType::BF16 ? LX_BF16 : -1;
+    view.shape = t->shape;
+    view.data = resident(*t);
+    return view;
+  };
+}
+
+// Rounds a BF16 [N, K] or [E, N, K] tensor to `type`, reading the file where it is mapped.
+lx_weight MappedWeights::convert(const TensorInfo& t, lx_wtype type) {
+  const int64_t K = t.shape.back();
+  const int64_t E = t.shape.size() == 3 ? t.shape[0] : 1;
+  const int64_t N = t.shape[t.shape.size() - 2];
+  if (type == LX_W_NVFP4 && K % 16 != 0) throw std::runtime_error(t.name + ": NVFP4 needs K % 16 == 0");
+  lx_weight w{type, nullptr, nullptr, 1.0f, nullptr};
+  uint8_t* data = static_cast<uint8_t*>(allocate(data_bytes(type, E * N, K)));
+  uint8_t* scale = static_cast<uint8_t*>(allocate(scale_bytes(type, E * N, K)));
+  w.data = data;
+  w.scale = scale;
+
+  // The source: the mapped bytes in place for the length of the conversion, or a device copy.
+  const uintptr_t at = reinterpret_cast<uintptr_t>(t.data);
+  const uintptr_t lo = at & ~(page_size() - 1);
+  void* dev = nullptr;
+  const void* src = nullptr;
+  void* copy = nullptr;
+  bool mapped = false;
+  if (lx_rt_map_host(reinterpret_cast<void*>(lo), static_cast<int64_t>(at + t.bytes - lo), &dev) == 0) {
+    src = static_cast<const uint8_t*>(dev) + (at - lo);
+    mapped = true;
+  } else {
+    check(lx_rt_alloc(&copy, static_cast<int64_t>(t.bytes)), "lx_rt_alloc");
+    check(lx_rt_copy(copy, t.data, static_cast<int64_t>(t.bytes), LX_COPY_H2D, nullptr), "uploading " + t.name);
+    src = copy;
+  }
+
+  if (type == LX_W_NVFP4 && E > 1) {
+    // Each expert keeps its own global, as NVFP4 checkpoints carry them.
+    std::vector<float> globals(E);
+    for (int64_t e = 0; e < E; ++e) {
+      lx_weight part{type, data + data_bytes(type, e * N, K), scale + scale_bytes(type, e * N, K), 1.0f, nullptr};
+      check(lx_quantize_weight(static_cast<const uint8_t*>(src) + e * N * K * 2, &part, N, static_cast<int>(K),
+                               nullptr),
+            "quantizing " + t.name);
+      globals[e] = part.global;
+    }
+    float* g = static_cast<float*>(allocate(sizeof(float) * E));
+    check(lx_rt_copy(g, globals.data(), static_cast<int64_t>(sizeof(float) * E), LX_COPY_H2D, nullptr),
+          "uploading the expert globals");
+    w.global = globals[0];
+    w.expert_global = g;
+  } else {
+    check(lx_quantize_weight(src, &w, E * N, static_cast<int>(K), nullptr), "quantizing " + t.name);
+  }
+  check(lx_rt_stream_sync(nullptr), "lx_rt_stream_sync");
+  if (mapped) lx_rt_unmap_host(reinterpret_cast<void*>(lo));
+  if (copy) lx_rt_free(copy);
+  return w;
+}
+
+ProjectionLookup MappedWeights::projections() {
+  return [this](const std::string& name, const std::vector<int64_t>& shape, bool quantize) {
+    const TensorInfo* t = set_.find(name);
+    if (!t) return lx_weight{LX_W_BF16, nullptr, nullptr, 1.0f, nullptr};
+    if (t->dtype != DType::BF16) throw std::runtime_error("projection " + name + " is not BF16 in the checkpoint");
+    if (t->shape != shape)
+      throw std::runtime_error("projection " + name + " has shape " + shape_text(t->shape) + ", expected " +
+                               shape_text(shape));
+    bool keep = !quantize;
+    for (const auto& frag : recipe_.keep) keep = keep || (!frag.empty() && name.find(frag) != std::string::npos);
+    const lx_wtype type = keep ? LX_W_BF16 : shape.size() == 3 ? recipe_.experts : recipe_.projections;
+    if (type == LX_W_BF16) return lx_weight{LX_W_BF16, resident(*t), nullptr, 1.0f, nullptr};
+    return convert(*t, type);
+  };
+}
+
+}  // namespace lx
