# Writes the Metal kernel library into a C++ source as one string, compiled at runtime with
# newLibraryWithSource (the offline Metal toolchain is not needed to build or to run).
#   cmake -DOUT=<file.cpp> -DNAME=<function> -DSOURCES="a|b|c" -P embed.cmake
# Each file goes in as raw-string chunks of at most ~16 KB, split at line ends.
set(body "")
string(REPLACE "|" ";" SOURCES "${SOURCES}")
foreach(src IN LISTS SOURCES)
  file(READ "${src}" text)
  get_filename_component(fname "${src}" NAME)
  string(APPEND body "    \"\\n// ---- ${fname}\\n\"\n")
  string(LENGTH "${text}" len)
  set(pos 0)
  while(pos LESS len)
    math(EXPR remain "${len} - ${pos}")
    if(remain GREATER 16000)
      string(SUBSTRING "${text}" ${pos} 16000 piece)
      string(FIND "${piece}" "\n" cut REVERSE)
      math(EXPR take "${cut} + 1")
      string(SUBSTRING "${text}" ${pos} ${take} piece)
    else()
      string(SUBSTRING "${text}" ${pos} ${remain} piece)
      set(take ${remain})
    endif()
    string(APPEND body "    R\"LXMETAL(${piece})LXMETAL\"\n")
    math(EXPR pos "${pos} + ${take}")
  endwhile()
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by engine/metal/embed.cmake. Do not edit.\nconst char* ${NAME}() {\n  return\n${body}  ;\n}\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
