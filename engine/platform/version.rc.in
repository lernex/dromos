// The version resource of each Windows binary (CMakeLists.txt): what Explorer's Properties and the Store's and
// Defender's dialogs show for it. Generated per target with its own file name and description.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @LX_RC_VERSION@
PRODUCTVERSION @LX_RC_VERSION@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE @LX_RC_FILETYPE@
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Lernex"
      VALUE "FileDescription", "@LX_RC_DESCRIPTION@"
      VALUE "FileVersion", "@LX_VERSION@"
      VALUE "InternalName", "@LX_RC_NAME@"
      VALUE "LegalCopyright", "Apache-2.0. See LICENSE and NOTICE."
      VALUE "OriginalFilename", "@LX_RC_FILE@"
      VALUE "ProductName", "Dromos"
      VALUE "ProductVersion", "@LX_VERSION@ (@LX_FLAVOR@, @LX_GIT_SHA@)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
