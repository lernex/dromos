<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The Windows executables' manifest (CMakeLists.txt). The UTF-8 code page makes the process's narrow strings UTF-8:
     arguments, environment variables and every path std::filesystem converts, so a user name or model folder outside
     ASCII works as it does on Linux and macOS. Long paths lift the 260-character limit for a deep model cache. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
