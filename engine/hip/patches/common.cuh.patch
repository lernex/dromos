--- a/common.cuh
+++ b/common.cuh
@@ -14,16 +14,16 @@
 // the programmatic dependent launch wait. LX_SM90_DEVICE is 1 in device code compiled for sm_90 or
 // newer and 0 everywhere else. The helpers below compile to nothing on the older targets, and the
 // host never launches a cluster kernel or asks for a dependent launch there: it checks lx_arch()
-// against lx::kNoClusterArch and takes the one-block path instead (the kernels' own fallbacks).
-#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 900
-#define LX_SM90_DEVICE 1
-#define LX_CLUSTER_DIMS(n) 
-#else
+// against lx::kClusterArch and takes the one-block path instead (the kernels' own fallbacks).
+// The HIP port has no thread-block clusters and no programmatic dependent launch: a cluster is one block
+// and the stream orders the kernels (lx_hip.h). The cluster helpers below are therefore the one-block forms.
 #define LX_SM90_DEVICE 0
 #define LX_CLUSTER_DIMS(n)
-#endif
 
 namespace lx {
+
+// HIP has no thread-block clusters: the kClusterArch gates compare against this, so no device takes the cluster path.
+constexpr int kNoClusterArch = 1 << 30;
 
 #if LX_SM90_DEVICE
 __device__ __forceinline__ unsigned cluster_block_rank() { return cooperative_groups::this_cluster().block_rank(); }
@@ -37,7 +37,7 @@
 __device__ __forceinline__ void pdl_wait() { lx_pdl_wait(); }
 #else
 __device__ __forceinline__ unsigned cluster_block_rank() { return 0; }
-__device__ __forceinline__ void cluster_sync() {}
+__device__ __forceinline__ void cluster_sync() { __syncthreads(); }  // a cluster of one block: a block barrier
 template <typename T>
 __device__ __forceinline__ T* cluster_peer(T* p, unsigned) {
   return p;
@@ -47,7 +47,7 @@
 #endif
 
 // Whether a launch may use a programmatic dependent launch on this device (host code).
-inline bool pdl_available() { return lx_arch() >= kClusterArch; }
+inline bool pdl_available() { return false; }  // no programmatic dependent launch on HIP
 
 __device__ __forceinline__ float to_f32(float v) { return v; }
 __device__ __forceinline__ float to_f32(__hip_bfloat16 v) { return __bfloat162float(v); }
